<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Feature tests run against a real PostgreSQL database, never
            sqlite/mocks: unique constraints, JSONB, and transaction
            semantics are load-bearing for this domain — see
            technology.md Section 8.2. Requires the dev Docker Compose
            stack (`docker compose up -d postgres`), which provisions
            this database in addition to the main one.

            force="true" is essential, not cosmetic: the app container gets
            DB_* from .env via compose `env_file`, and a plain <env> entry
            will NOT override a variable that already exists in the real
            environment. Without it, `php artisan test` inside the container
            silently points RefreshDatabase at the development database and
            wipes it.
        -->
        <env force="true" name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env force="true" name="DB_DATABASE" value="gym_platform_testing"/>
        <env name="DB_USERNAME" value="gym_platform"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env force="true" name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
